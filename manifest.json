{
  "manifest_version": 3,
  "name": "Table to Sheets — CSV Exporter",
  "version": "1.0.0",
  "description": "Pull any HTML table off a page and take it to CSV or straight into Google Sheets, merged cells intact.",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "downloads"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Table to Sheets",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
